{
  "name": "@ephox/bedrock",
  "description": "NodeJS test runner",
  "repository": {
    "type": "git",
    "url": "https://github.com/ephox/bedrock"
  },
  "scripts": {
    "bedrock": "node modules/server/bin/bedrock.cjs",
    "bedrock-auto": "node modules/server/bin/bedrock-auto.cjs",
    "lint": "oxlint modules/common/src modules/client/src modules/runner/src modules/server/src modules/server/tasks",
    "prepublishOnly": "bun run build",
    "clean": "git clean -dfx lib dist modules node_modules",
    "build-common": "bun run --filter @ephox/bedrock-common build",
    "build-client": "bun run --filter @ephox/bedrock-client build",
    "build-runner": "bun run --filter @ephox/bedrock-runner build",
    "build-server": "bun run --filter @ephox/bedrock-server build",
    "build": "lerna run build --ignore @ephox/bedrock-sample",
    "test-common": "bun run --filter @ephox/bedrock-common test",
    "test-client": "bun run --filter @ephox/bedrock-client test",
    "test-runner": "bun run --filter @ephox/bedrock-runner test",
    "test-server": "bun run --filter @ephox/bedrock-server test",
    "test-sample": "bun run --filter @ephox/bedrock-sample test",
    "test-samples-fail": "bun run --filter @ephox/bedrock-sample test-samples-fail",
    "test": "bun run lint && bun run build && lerna run --ignore @ephox/bedrock-sample test"
  },
  "private": true,
  "workspaces": [
    "modules/*"
  ],
  "packageManager": "bun@1.3.12",
  "resolutions": {
    "tslib": "^2.8.1"
  },
  "patchedDependencies": {
    "sourcemapped-stacktrace@1.1.11": "patches/sourcemapped-stacktrace@1.1.11.patch"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.6.2",
    "@types/request": "^2.48.13",
    "@types/which": "^3.0.4",
    "chai": "^6.2.2",
    "fast-check": "^4.9.0",
    "fast-deep-equal": "^3.1.3",
    "grunt": "^1.6.3",
    "lerna": "^10.0.0",
    "load-grunt-tasks": "^5.1.0",
    "mocha": "^11.8.0",
    "oxlint": "^1.85.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "author": "Tiny Technologies Inc",
  "license": "Apache-2.0",
  "files": []
}
