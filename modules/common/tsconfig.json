{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "useUnknownInCatchVariables": false,
    "target": "es2019",
    "module": "esnext",
    "lib": [
      "es2022",
      "dom"
    ],
    "declaration": true,
    "sourceMap": true,
    "outDir": "lib",
    "rootDir": "src",
    "types": []
  },
  "include": [
    "src/main/ts",
    "src/test/ts"
  ]
}
